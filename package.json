{
  "name": "apishield-local",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "db:generate": "prisma generate --schema packages/database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/schema.prisma",
    "setup": "tsx scripts/setup.ts",
    "test:e2e": "playwright test",
    "test:integration": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.4.0",
    "express": "5.1.0",
    "fastify": "^5.0.0",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "undici": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
